{
  "name": "webagent-core",
  "displayName": "Web Agent & Bridge",
  "description": "Web Agent Chat / Agent / Bridge. Talks to the local agent-host process.",
  "version": "0.7.2",
  "publisher": "webagent",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:webagent.agent"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Web Agent",
      "properties": {
        "webagent.agentHostUrl": {
          "type": "string",
          "default": "http://127.0.0.1:48271",
          "description": "手工指定已运行主机的根地址（仅限本机）。不修改（保持默认、未在用户或工作区设置中填写）时，插件自己管理主机：侧栏“主机”卡片一键启动，或自动接管同一文件夹上已运行的主机。一旦在设置中填写（即使填的是默认值），插件只连接该地址、不会自己启动主机。"
        },
        "webagent.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "启动主机用的 node 可执行文件完整路径；留空使用系统 PATH 中的 node。只读用户设置，工作区设置不生效。"
        },
        "webagent.autoStartHost": {
          "type": "boolean",
          "default": false,
          "description": "打开已信任的文件夹时自动启动主机（只启动本机主机，从不自动开启 Bridge 隧道）。"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "webagent.agent",
        "fullName": "Web Agent",
        "name": "webagent",
        "description": "对本机工作区搜、读、打补丁、跑测试（Ask / Plan / Agent）",
        "isSticky": true,
        "isDefault": true,
        "commands": [
          {
            "name": "ask",
            "description": "只读探查，不改文件"
          },
          {
            "name": "plan",
            "description": "多模型博弈出方案，不改文件"
          },
          {
            "name": "code",
            "description": "Agent：搜-读-补丁-再测"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "webagent-sidebar",
          "title": "Web Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "webagent-sidebar": [
        {
          "type": "webview",
          "id": "webagent.chatView",
          "name": "Web Agent Chat & Agent"
        },
        {
          "type": "webview",
          "id": "webagent.bridgeView",
          "name": "Bridge 模式 (远程指挥台)"
        }
      ]
    },
    "commands": [
      {
        "command": "webagent.openBridge",
        "title": "Web Agent: 打开 Bridge 面板"
      },
      {
        "command": "webagent.openAgentChat",
        "title": "Web Agent: 打开 Agent Chat"
      },
      {
        "command": "webagent.resetSecret",
        "title": "Web Agent: 重置 Bridge Secret"
      },
      {
        "command": "webagent.previewEditorChanges",
        "title": "Web Agent: 预览当前草稿与磁盘差异"
      },
      {
        "command": "webagent.restoreEditorDraft",
        "title": "Web Agent: 预览并恢复当前草稿为磁盘版本"
      },
      {
        "command": "webagent.startHost",
        "title": "Web Agent: 启动主机"
      },
      {
        "command": "webagent.stopHost",
        "title": "Web Agent: 停止主机"
      },
      {
        "command": "webagent.showHostLog",
        "title": "Web Agent: 查看主机日志"
      },
      {
        "command": "webagent.openSettings",
        "title": "Web Agent: 打开设置",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "webagent.openSettings",
          "when": "view == webagent.bridgeView",
          "group": "navigation"
        },
        {
          "command": "webagent.openSettings",
          "when": "view == webagent.chatView",
          "group": "navigation"
        }
      ]
    }
  }
}
