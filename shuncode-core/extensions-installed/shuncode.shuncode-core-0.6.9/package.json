{
  "name": "shuncode-core",
  "displayName": "ShunCode AI Agent & Bridge",
  "description": "ShunCode Chat / Bridge sidebar. Talks to the local agent-host MCP process.",
  "version": "0.6.9",
  "publisher": "shuncode",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "ShunCode",
      "properties": {
        "shuncode.agentHostUrl": {
          "type": "string",
          "default": "http://127.0.0.1:48271",
          "description": "agent-host 根地址（MCP /api 与 /mcp）。Windows 本机保持默认即可。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shuncode-sidebar",
          "title": "ShunCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "shuncode-sidebar": [
        {
          "type": "webview",
          "id": "shuncode.chatView",
          "name": "ShunCode Chat & Agent"
        },
        {
          "type": "webview",
          "id": "shuncode.bridgeView",
          "name": "Bridge 模式 (远程指挥台)"
        }
      ]
    },
    "commands": [
      {
        "command": "shuncode.openBridge",
        "title": "ShunCode: 打开 Bridge 面板"
      },
      {
        "command": "shuncode.resetSecret",
        "title": "ShunCode: 重置 Bridge Secret"
      }
    ]
  }
}
