{
  "name": "shuncode-core",
  "displayName": "ShunCode AI Agent & Bridge",
  "description": "ShunCode Chat / Agent / Bridge. Talks to the local agent-host process.",
  "version": "0.6.9",
  "publisher": "shuncode",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other", "Chat"],
  "activationEvents": ["*", "onChatParticipant:shuncode.agent"],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "ShunCode",
      "properties": {
        "shuncode.agentHostUrl": {
          "type": "string",
          "default": "http://127.0.0.1:48271",
          "description": "agent-host 根地址（MCP /api 与 /mcp）。Windows 本机保持默认即可。"
        }
      }
    },
    "chatParticipants": [
      {
        "id": "shuncode.agent",
        "fullName": "ShunCode",
        "name": "shuncode",
        "description": "对本机工作区搜、读、打补丁、跑测试（Ask / Plan / Agent）",
        "isSticky": true,
        "isDefault": true,
        "commands": [
          { "name": "ask", "description": "只读探查，不改文件" },
          { "name": "plan", "description": "多模型博弈出方案，不改文件" },
          { "name": "code", "description": "Agent：搜-读-补丁-再测" }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shuncode-sidebar",
          "title": "ShunCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "shuncode-sidebar": [
        {
          "type": "webview",
          "id": "shuncode.chatView",
          "name": "ShunCode Chat & Agent"
        },
        {
          "type": "webview",
          "id": "shuncode.bridgeView",
          "name": "Bridge 模式 (远程指挥台)"
        }
      ]
    },
    "commands": [
      {
        "command": "shuncode.openBridge",
        "title": "ShunCode: 打开 Bridge 面板"
      },
      {
        "command": "shuncode.openAgentChat",
        "title": "ShunCode: 打开 Agent Chat"
      },
      {
        "command": "shuncode.resetSecret",
        "title": "ShunCode: 重置 Bridge Secret"
      }
    ]
  }
}
