# Dependencies
node_modules/
.npm/

# Binary apps and caches
code-server-app/
bin/code-server-runtime/*
!bin/code-server-runtime/package.json
.cache/
.local/
*.tar.gz
*.tmp.*

# Build artifacts
dist/
build/
out/
*.log

# System files
.DS_Store
Thumbs.db

# Local secrets / model keys (any workspace path, not only ./workspace)
**/.webagent/config.json
**/.webagent/read-hashes.json
**/.webagent/usage.json
**/.webagent/board.json

# Admin host local token + reports
webagent-core/admin-host/data/

# Rewritten on launch with a machine-absolute path
webagent-core/extensions-installed/extensions.json

# Local screenshot dumps (never part of the product)
image-search/

# project-manager privacy map (real secrets / PII)
manager/privacy.md

# installer build output (never part of the product)
installer/output/

# User probe raw captures and interpreter caches: may contain credentials/private traffic.
arena-model-probe/recon/
arena-model-probe/**/__pycache__/
arena-model-probe/dist/

# Locally built standalone VS Code companion
webagent-core/probe-extension/dist/

# Python build/import caches (Conda or system Python)
__pycache__/
*.py[cod]

# Web Agent — do not commit MCP secret or API keys
.webagent/memory/
.webagent/customizations.json
.webagent/instructions.md
.webagent/preference.md
.webagent/tech-stack.md
