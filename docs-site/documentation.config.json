{
  "version": 1,
  "sourceExtensions": [
    ".js",
    ".mjs",
    ".cjs",
    ".ts",
    ".tsx",
    ".jsx",
    ".py",
    ".json",
    ".html",
    ".css",
    ".yaml",
    ".yml",
    ".xml",
    ".svg",
    ".ps1",
    ".cs",
    ".cmd",
    ".bat",
    ".sh",
    ".iss"
  ],
  "exclusions": [
    {
      "prefix": "webagent-repro/",
      "reason": "冻结原型，由现有README说明，不计当前产品覆盖率"
    },
    {
      "prefix": "webagent-core/extensions-installed/",
      "reason": "发行副本；以extension源码为准，现有副本一致性测试负责校验"
    },
    {
      "prefix": "bin/code-server-dist/",
      "reason": "第三方运行时"
    },
    {
      "prefix": "bin/code-server-runtime/",
      "reason": "第三方运行时"
    },
    {
      "prefix": "workspace/",
      "reason": "示例工作区和用户数据；维护规范另由docs-sync Skill引用"
    },
    {
      "prefix": ".config/",
      "reason": "历史运行配置，已有目录说明；不扫描用户配置正文"
    },
    {
      "path": "docs-site/content.js",
      "reason": "由Markdown生成的文档站内容"
    },
    {
      "path": "docs-site/documentation-manifest.json",
      "reason": "本工具生成的清单，避免自引用"
    }
  ],
  "rootScriptDoc": "启动脚本说明.md",
  "rootDoc": "README.md",
  "extraSiteDocs": [
    {
      "id": "documentation-policy",
      "path": "manager/docs/documentation.md",
      "group": "维护"
    },
    {
      "id": "source-index",
      "path": "docs-site/source-index.md",
      "group": "维护"
    },
    {
      "id": "documentation-quality",
      "path": "review/DOC_QUALITY_2026-09-12.md",
      "group": "维护"
    },
    {
      "id": "conda-windows",
      "path": "Conda环境说明.md",
      "group": "运行与验收"
    },
    {
      "id": "windows-acceptance",
      "path": "review/CHECKLIST_WINDOWS.md",
      "group": "运行与验收"
    },
    {
      "id": "code-learning",
      "path": "代码复盘指南.md",
      "group": "源码复盘"
    },
    {
      "id": "installer-functions",
      "path": "installer/函数详解.md",
      "group": "源码复盘"
    },
    {
      "id": "host-entry-functions",
      "path": "webagent-core/agent-host/src/入口详解.md",
      "group": "源码复盘"
    },
    {
      "id": "utils-functions",
      "path": "webagent-core/agent-host/src/utils/函数详解.md",
      "group": "源码复盘"
    },
    {
      "id": "tunnel-stop-functions",
      "path": "webagent-core/agent-host/src/tunnel/停止进程详解.md",
      "group": "源码复盘"
    },
    {
      "id": "test-runner-functions",
      "path": "webagent-core/agent-host/scripts/运行器详解.md",
      "group": "源码复盘"
    }
  ],
  "sourceSnapshotExclusions": [
    {
      "prefix": "webagent-core/agent-host/tests/",
      "reason": "测试fixture源码不嵌入可能随安装包发行的content.js；保留结构索引和README归属"
    }
  ]
}
